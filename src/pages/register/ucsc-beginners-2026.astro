---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout
  metadata={{
    title: 'UCSC Beginners 2026 Registration',
    description: 'Register for UCSC Beginners 2026.',
  }}
>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter">
      UCSC Beginners 2026 Registration
    </h1>
    <p class="mt-4 mb-8 text-muted">
      Complete the form below, or <a
        href="https://stanford-ballroom.notion.site/ebd//9fe1b84b0077827b93b2816f23696813"
        target="_blank"
        rel="noopener noreferrer"
        class="text-primary underline">open the registration form in a new tab</a
      >.
    </p>
    <iframe
      src="https://stanford-ballroom.notion.site/ebd//9fe1b84b0077827b93b2816f23696813"
      title="UCSC Beginners 2026 registration form"
      width="100%"
      height="600"
      class="border-0"
      allowfullscreen
    ></iframe>
  </section>
</Layout>
